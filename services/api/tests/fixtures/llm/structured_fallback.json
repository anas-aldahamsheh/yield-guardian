{
  "meta": {
    "hand_authored": true,
    "description": "Writer chain: DeepSeek-V4.1-Flash (json_object) answers with text that is not JSON, so the gateway falls back to MiMo-V2.6-Flash (json_object; it refuses strict json_schema live), whose answer validates.",
    "source": "docs/vendor/token-factory.md: every chat model accepts json_object; MiMo-V2.6-Flash refused strict json_schema live on 2026-10-14. Answer texts are written for the fixture."
  },
  "interactions": [
    {
      "request": {
        "method": "POST",
        "path": "/chat/completions",
        "match": {"model": "DeepSeek-V4.1-Flash", "reasoning_effort": "low", "response_format": {"type": "json_object"}}
      },
      "response": {
        "status": 200,
        "json_body": {
          "id": "chatcmpl-fixture-structured-1",
          "object": "chat.completion",
          "model": "DeepSeek-V4.1-Flash",
          "choices": [
            {"index": 0, "message": {"role": "assistant", "content": "Sorry, here is prose instead of JSON."}, "finish_reason": "stop"}
          ],
          "usage": {"prompt_tokens": 1500, "completion_tokens": 50, "total_tokens": 1550, "completion_tokens_details": {"reasoning_tokens": 10}}
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/chat/completions",
        "match": {"model": "MiMo-V2.6-Flash", "reasoning_effort": "none", "response_format": {"type": "json_object"}}
      },
      "response": {
        "status": 200,
        "json_body": {
          "id": "chatcmpl-fixture-structured-2",
          "object": "chat.completion",
          "model": "MiMo-V2.6-Flash",
          "choices": [
            {"index": 0, "message": {"role": "assistant", "content": "```json\n{\"label\": \"fixture\", \"count\": 3}\n```"}, "finish_reason": "stop"}
          ],
          "usage": {"prompt_tokens": 1500, "completion_tokens": 40, "total_tokens": 1540}
        }
      }
    }
  ]
}
