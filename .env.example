# Yield Guardian settings. Copy this file and fill it in; a .env file is never committed.
#
#   Docker stack:       cp .env.example deploy/compose/.env   (see deploy/compose/README.md)
#   Local development:  cp .env.example .env
#
# Leave optional settings commented out rather than empty: an empty value is still a value.
# Quote a value that contains "$" with single quotes (for example a password hash).

# ---------------------------------------------------------------------------------------------
# Required for the Docker stack (it refuses to start while these are empty)

# Database password. Letters and digits only (it goes into a connection URL):
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Signs session cookies and CSRF tokens. At least 32 random bytes, base64:
#   openssl rand -base64 48
SESSION_SECRET=

# ---------------------------------------------------------------------------------------------
# Address and gateway (Docker stack)

# Host port of the gateway's plain HTTP listener (default 8080). With DOMAIN set, use 80.
# HTTP_PORT=8080
# Host port of the HTTPS listener (default 8443). With DOMAIN set, use 443.
# HTTPS_PORT=8443
# A public domain name that points at this host. When set, the gateway serves it with automatic
# HTTPS (Let's Encrypt) on 443 and redirects 80 to it. Unset: plain HTTP on HTTP_PORT.
# DOMAIN=yield-guardian.example.com
# Public address of the app (cookies, links). Default: http://localhost:${HTTP_PORT}.
# With DOMAIN set: https://<DOMAIN>.
# PUBLIC_URL=http://localhost:8080
# Proxies in front of the gateway whose X-Forwarded-* headers are trusted: CIDR ranges separated
# by spaces, or private_ranges. Default: none (127.0.0.1/32).
# TRUSTED_PROXIES=private_ranges

# ---------------------------------------------------------------------------------------------
# AMD Token Factory (optional: without a key, live investigations and chat are off and recorded
# runs are shown). Shared team key, format rc- followed by 48 hex characters.
# TOKEN_FACTORY_API_KEY=rc-<48 hex characters>
TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# ---------------------------------------------------------------------------------------------
# Admin login (optional: without it, there is no admin login)
# ADMIN_USERNAME=admin
# scrypt hash made by services/api/scripts/hash_password.py (in the stack:
#   docker compose -f deploy/compose/compose.yaml run --rm -it api python scripts/hash_password.py).
# It contains "$", so keep the single quotes:
# ADMIN_PASSWORD_HASH='scrypt$...'
# How long the engineer or admin role lasts, in minutes (5 to 1440, default 120); the device
# then goes on as a visitor and keeps its workspace.
# SESSION_TTL_MINUTES=120
# A device's session, and so its workspace, ends this many days after it was last used (1 to
# 365, default 30); a workspace is deleted with its runs, uploads and investigations when no
# device uses it any more.
# WORKSPACE_SESSION_DAYS=30
# A code to continue on another device ends this many minutes after it is made (1 to 60,
# default 10).
# HANDOFF_MINUTES=10

# ---------------------------------------------------------------------------------------------
# Operations (optional)

# DEBUG, INFO (default), WARNING or ERROR; LOG_JSON=false for human-readable logs.
# LOG_LEVEL=INFO
# LOG_JSON=true
# Commit the images are built from (shown in /api/v1/meta), for example $(git rev-parse HEAD).
# GIT_COMMIT=
# Prebuilt images to run instead of building from this checkout.
# API_IMAGE=yield-guardian/api:latest
# WEB_IMAGE=yield-guardian/web:latest
# Product name, held in one place (decision D-007).
# APP_NAME=Yield Guardian

# ---------------------------------------------------------------------------------------------
# Local development only (the Docker stack sets these itself)

# The compose file builds DATABASE_URL from POSTGRES_PASSWORD and ignores this line.
DATABASE_URL=postgresql+asyncpg://yield_guardian:change-me@localhost:5432/yield_guardian
# development (default), test or production.
# ENVIRONMENT=development
# Apply database migrations when the API starts (default true). The Docker stack sets false,
# because its migrate service runs them first.
# MIGRATE_ON_START=true
# Model bundles load from ARTIFACTS_DIR/secom/vN (newest verified version). SECOM_DATA_DIR must
# hold the real secom.data and secom_labels.data: the API cross-checks the timeline against them.
# The API image sets /app/artifacts and /app/data/secom.
# ARTIFACTS_DIR=artifacts
# SECOM_DATA_DIR=data/secom
# Browser origins allowed to call the API directly, as a JSON list. Not needed behind the
# gateway, where the web app and the API share one origin.
# CORS_ORIGINS=["http://localhost:3000"]
# Web app: where the Next.js server reaches the API, and the API base handed to browsers.
# API_INTERNAL_URL=http://localhost:8000
# API_PUBLIC_URL=http://localhost:8000/api/v1

# Language-model test cassettes: "replay" (default, offline) or "record" (needs the key; never in CI)
YG_LLM_CASSETTE_MODE=replay
