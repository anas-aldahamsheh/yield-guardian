# Copy to .env and fill in. .env is never committed.

# AMD Token Factory (shared team key, format rc- followed by 48 hex characters)
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# Public address of the app (used for CORS, cookies and links)
PUBLIC_URL=http://localhost:3000

# Database (the compose file builds this from POSTGRES_PASSWORD)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://yield_guardian:change-me@localhost:5432/yield_guardian

# Language-model test cassettes: "replay" (default, offline) or "record" (needs the key; never in CI)
YG_LLM_CASSETTE_MODE=replay
