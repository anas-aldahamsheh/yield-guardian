{
  "name": "@yield-guardian/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI schema of the Yield Guardian API and the TypeScript types generated from it",
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "src",
    "openapi.json",
    "fixtures",
    "ARTIFACTS.md"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.d.ts --root-types --root-types-no-schema-prefix --alphabetize && prettier --write src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
